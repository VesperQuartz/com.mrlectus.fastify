{
	"type": "module",
	"name": "com.mrlectus.fastify",
	"version": "1.0.0",
	"description": "This project was bootstrapped with Fastify-CLI.",
	"main": "app.ts",
	"directories": {
		"test": "test"
	},
	"scripts": {
		"build:ts": "tsc",
		"watch:ts": "tsc -w",
		"db:push": "drizzle-kit push",
		"test": "bun test",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"auth:generate": "bunx @better-auth/cli generate --output ./src/models/schemas/auth.schema.ts",
		"auth:migrate": "bunx @better-auth/cli migrate",
		"dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 bun --watch run server.ts",
		"start": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 bun --bun run server.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@fastify/autoload": "^6.4.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/csrf-protection": "^8.0.0",
		"@fastify/env": "^7.0.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/jwt": "^10.2.0",
		"@fastify/multipart": "^10.1.0",
		"@fastify/one-line-logger": "^2.1.0",
		"@fastify/rate-limit": "^11.1.0",
		"@fastify/redis": "^8.0.0",
		"@fastify/sensible": "^6.0.4",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.0",
		"@fastify/websocket": "^11.3.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.10.0",
		"fastify-cli": "^8.0.0",
		"fastify-plugin": "^6.0.0",
		"fastify-type-provider-zod": "^7.0.0",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"c8": "^11.0.0",
		"concurrently": "^10.0.3",
		"drizzle-kit": "^0.31.10",
		"fastify-tsconfig": "^3.0.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.23.1",
		"typescript": "~7.0.2"
	}
}
